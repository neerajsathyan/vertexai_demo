# Environment Configuration
# Copy this file to .env and update with your values

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Vertex AI Configuration
VERTEX_AI_STAGING_BUCKET=gs://your-staging-bucket
MODEL_DISPLAY_NAME=custom-model
DATASET_DISPLAY_NAME=custom-dataset

# Training Configuration
TRAINING_MACHINE_TYPE=n1-standard-4
TRAINING_REPLICA_COUNT=1

# Data Configuration
DATA_BUCKET=your-data-bucket
BIGQUERY_DATASET=your_dataset